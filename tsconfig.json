{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "*": ["./backend/node_modules/*"]
    },
    "typeRoots": ["./backend/node_modules/@types"]
  },
  "include": ["scripts/**/*"]
}
